  "configurations": [
    {
      "id": "current-official-printed-seat-map",
      "canonicalName": "通常配置・公式番号席1,802席",
      "selectionBasis": "現行公式座席表PDFに描かれた番号席セルを直接転記した通常配置。同図が明記する「1階席 1,242席／2階席 560席／計 1,802席」に対し、1階32列で1,242席、2階21列で560席が完全に一致する。各列の座席番号は1〜44の通し番号で、公式図の通路位置でブロックに分かれる。",
      "issuerDefinedCondition": "文京アカデミーが大ホール座席表として公開する通常配置を使用する場合。",
      "definitionAuthority": "issuer",
      "sourceGeneration": "current official 大ホール座席表 PDF linked from the 座席表 page",
      "sourceIds": [
        "official-seat-map",
        "official-seat-page",
