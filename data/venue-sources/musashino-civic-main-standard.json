  "configurations": [
    {
      "id": "current-official-printed-seat-map",
      "canonicalName": "通常配置・公式座席表の印字番号席1,252席",
      "selectionBasis": "現行公式大ホール座席表に印字された全番号席1,252席を直接転記した通常配置。issuerが各ブロックの内側に印字する1〜43列の行ラベルで一意化し、図の脚注が示す1階912席・2階340席の階別小計と完全一致させた。",
      "issuerDefinedCondition": "武蔵野文化生涯学習事業団が固定席1,252席（1階912席・2階340席）として公開する大ホール座席表を使用する場合。",
      "definitionAuthority": "issuer",
      "sourceGeneration": "2026-08-24 current official printed seat map",
      "sourceIds": [
        "official-seat-map",
        "official-facility-guide"
      ],
      "differenceBasisSourceIds": [
        "official-seat-map"
      ],
      "status": "production",
      "selectable": true,
      "numberedSeatSetComplete": true,
      "capacityFitting": false,
      "repositoryInventedDifferences": false,
      "expectedSeatCount": 1256,
      "scope": {
        "kind": "official-variant",
        "issuerDefined": true,
        "containsEventDependentSeatIds": false
      },
      "scopeDisclosure": "公式座席表の印字番号席1,252席を抽選します。転記結果の階別内訳は1階席1〜25列912席・2階席26〜43列340席で、図の脚注「固定席1,252席（1階912席 2階340席）」と完全一致します。番号のない車椅子席4席は登録しません。オーケストラピット使用時の固定席1,097席と仮設舞台階段使用時の配置は通常配置と別であり反映しません。",
      "wheelchairSemantics": {
        "status": "not-reflected",
        "description": "公式座席表は1階7・8列付近の左右に無番号の「車椅子席」区画を描き、脚注で車椅子席4席を固定席1,252席とは別行に記載する。番号を印字しないためseat IDを作成しない。",
        "sourceIds": [
          "official-seat-map"
        ],
        "accessibilityConversionNotReflected": true
      },
      "confidence": "representative",
      "verification": {
        "status": "reviewed",
        "checkedAt": "2026-08-24",
        "method": "current-official-pdf-vector-text-layer-extraction-with-per-block-issuer-row-label-mapping-and-floor-subtotal-reconciliation",
        "seatStructure": "matched",
        "seatCount": "mismatched",
        "rangeDiff": -4,
        "unresolvedIssues": [
          "公式定員1,256席と印字番号席1,252席の差4は、図の脚注が別行で示す番号のない車椅子席4席である。seat IDを作成しない。",
          "issuerは各ブロックの内側に行ラベルを個別に印字するため、最外ブロックの行帰属は図形位置ではなく印字ラベルで確定した。1階9列に最外ブロックがなく、1階25列が最外ブロックのみで構成されることはラベル列の構成と一致する。",
          "26〜36列は左右の壁沿いブロックのみで構成され、37〜43列の後方バルコニーと合わせて公式の2階340席と一致する。issuerは各列に階名を印字しないため、階の帰属は脚注の階別小計との算術一致で確定した。",
          "オーケストラピット使用時1,097席および仮設舞台階段使用時の除外seat IDは公式に公開されていない。"
        ]
      },
