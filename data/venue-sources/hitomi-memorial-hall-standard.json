    {
      "id": "current-official-printed-seat-map",
      "canonicalName": "通常配置・公式座席表の印字番号席2,070席",
      "selectionBasis": "現行公式座席表（B）に印字された全番号席2,070席を直接転記した通常配置。issuerが図に印字する1階ホール2〜35列、2階ホールA〜L列の行ラベルと、1階1〜54番・2階1〜50番の通し番号で一意化する。",
      "issuerDefinedCondition": "昭和女子大学が公開する人見記念講堂座席表（B）の通常配置を使用する場合。",
      "definitionAuthority": "issuer",
      "sourceGeneration": "2026-08-24 current official printed seat map (座席表B)",
      "sourceIds": [
        "official-seat-map",
        "official-facility-guide"
      ],
