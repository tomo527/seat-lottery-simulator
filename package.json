{
  "name": "seat-lottery-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && npm run venues:check && npm run venues:validate && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:docs": "node scripts/verify-docs.mjs && npm run verify:harness && git diff --check HEAD",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:app": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:docs",
    "verify:full": "npm run verify:app && npm run test:e2e",
    "verify:venues": "npm run venues:inventory:report && npm run venues:readiness:report && npm run venues:release:coverage && npm run venues:build && npm run venues:check && npm run venues:validate && npm run venues:report && npm run verify:full",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "venues:new": "node scripts/venues/new-venue.mjs",
    "venues:review": "node scripts/venues/review-venue.mjs",
    "venues:inventory:report": "node scripts/venues/inventory-report.mjs",
    "venues:batch:report": "node scripts/venues/batch-report.mjs",
    "venues:readiness:report": "node scripts/venues/readiness-report.mjs",
    "venues:release:coverage": "node scripts/venues/release-coverage-report.mjs",
    "venues:build": "node scripts/venues/build-catalog.mjs",
    "venues:check": "node scripts/venues/check-database.mjs",
    "venues:validate": "node scripts/venues/validate-database.mjs",
    "venues:report": "node scripts/venues/report-database.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
